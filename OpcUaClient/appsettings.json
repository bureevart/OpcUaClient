{
  "ConnectionStrings": {
    "EntityContext": "Server=localhost;Port=5432;Database=OpcUaClient;User Id=postgres;Password=postgres; Pooling = true; Maximum Pool Size = 20;"
  },
  "OpcUaSettings": {
    "Host": "127.0.0.1",
    "Port": "4840",
    "OpcNameSpace": "2",
    "SessionRenewalRequired": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMQ": {
    "User": "user",
    "Password": "user",
    "Server": "localhost",
    "VirtualHost": "/"
  },
  "Cache": {
    "CacheService": {
      "DefaultExpirationTimeInMinutes": 120
    }
  },
  "CORS": {
    "Methods": [ "GET", "POST", "DELETE", "PUT"],
    "Headers": [ "*" ],
    "Origins": [ "*" ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5137"
      }
    }
  },
  "AllowedHosts": "*"
}
